                    "ai":  "qwen3.8-flash"
                },
                {
                    "t":  "step",
                    "id":  "s9",
                    "kind":  "act",
                    "label":  "Update booking record",
                    "runs":  "fc",
                    "product":  "tablestore",
                    "effect":  "write"
                },
                {
                    "t":  "step",
                    "id":  "s1",
