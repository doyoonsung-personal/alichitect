{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": { "@ali/core/*": ["../../packages/core/src/*"], "@ali/catalog/*": ["../../packages/core/catalog/*"], "@ali/bd-brief/*": ["../../packages/bd-brief/src/*"] }
  },
  "include": ["src", "scripts/replay", "scripts/export", "vite.config.ts", "../../packages/core/src", "../../packages/bd-brief/src"]
}
