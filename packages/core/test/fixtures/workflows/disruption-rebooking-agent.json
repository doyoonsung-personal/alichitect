{
    "id":  "disruption-rebooking-agent",
    "title":  "Flight Disruption Rebooking Agent",
    "ask":  "Build an agent that monitors flight statuses and automatically proposes rebooking options for approval when disruptions happen",
    "oneRun":  "One disruption-status event for a persisted booking; recheck events stop after rebooking or 24 hours. Each run proposes and approves one rebooking.",
    "settings":  {
                     "region":  "ap-southeast-1"
                 },
    "ops":  [
                {
                    "t":  "step",
                    "id":  "s8",
                    "kind":  "act",
                    "label":  "Notify passenger of new itinerary",
                    "runs":  "fc",
                    "product":  "chatapp",
                    "effect":  "send"
                },
                {
                    "t":  "step",
                    "id":  "s7",
                    "kind":  "act",
                    "label":  "Execute rebooking via GDS API",
                    "runs":  "fc",
                    "product":  "fc",
                    "effect":  "pay"
                },
                {
                    "t":  "step",
                    "id":  "s6",
                    "kind":  "human",
                    "label":  "Approve rebooking and fare difference",
