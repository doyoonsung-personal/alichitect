{
  "id": "wf-video-ad",
  "mode": "workflow",
  "category": "pattern",
  "lang": "en",
  "title": "Product description to an approved video ad",
  "reference": "Create a 15-second vertical video ad with voice-over, human approval before publish, no video gap, and an availability follow-up.",
  "turns": [
    {
      "ask": "Build a workflow that turns a product description into a 15-second vertical video ad with a voice-over, for a person to approve before we post it.",
      "expect": {
        "workflow": {
          "kinds": [
            "trigger",
            "human"
          ],
          "tasks": [
            "create",
            "speak",
            "approve"
          ],
          "products": [
            [
              "model-studio"
            ]
          ],
          "effects": [
            "publish"
          ],
          "approvals": true,
          "boundedLoops": true,
          "international": true,
          "noWarnings": [
            "wf-ai-missing",
            "wf-ai-mismatch",
            "wf-approval",
            "wf-human-outcomes"
          ],
          "modelOutputs": {
            "create": [
              "video"
            ]
          },
          "noGaps": [
            "video|영상|비디오|视频|視頻|影片|影像|\\b(?:t2v|i2v|r2v)\\b"
          ],
          "notMention": [
            "\\bno\\s+(?:alibaba\\s+)?(?:text[-\\s]+to[-\\s]+)?video",
            "\\b(?:does\\s+not|doesn['’]t)\\s+(?:have|offer|support)\\b[^.!?\\n]{0,100}\\bvideo",
            "\\blacks?\\b[^.!?\\n]{0,60}\\bvideo",
            "\\bvideo[^.!?\\n]{0,80}\\b(?:unavailable|unsupported|not\\s+(?:available|supported|offered))\\b",
            "(?:영상|비디오)[^.!?\\n]{0,60}(?:없(?:습니다|어요|다|음|는)|지원(?:을|이)?\\s*하지\\s*않|지원(?:이)?\\s*(?:불가|안))",
            "지원(?:을)?\\s*하지\\s*않[^.!?\\n]{0,40}(?:영상|비디오)"
          ]
        }
      }
    }
  ]
}
