{
    "id":  "code-review-pr-agent",
    "title":  "Code Review and Pull-Request Agent",
    "ask":  "Deploy a coding agent that reviews pull requests, runs tests in a sandbox to verify its own comments, filters out noise, and leaves final approval to a human reviewer",
    "oneRun":  "One webhook event for this request; bounded retries stay in this run. Later conversation turns, daily checks and monitoring events start new runs using persisted state.",
    "settings":  {
                     "region":  "ap-southeast-1"
                 },
    "ops":  [
                {
                    "t":  "step",
                    "id":  "done",
                    "kind":  "end",
                    "label":  "Run complete"
                },
                {
                    "t":  "step",
                    "id":  "cancel",
                    "kind":  "end",
                    "label":  "Cancelled or unresolved"
                },
                {
                    "t":  "step",
                    "id":  "s7",
                    "kind":  "human",
                    "label":  "Human required-reviewer approves PR",
                    "runs":  "customer",
                    "task":  "approve",
                    "subject":  "s3"
                },
                {
                    "t":  "step",
                    "id":  "s8",
                    "kind":  "act",
                    "label":  "Notify author and update quality report",
                    "runs":  "fc",
                    "product":  "direct-mail",
                    "effect":  "notify"
                },
                {
                    "t":  "step",
                    "id":  "retry-route",
                    "kind":  "decide",
                    "label":  "Retry or continue",
                    "runs":  "fc"
                },
                {
                    "t":  "step",
                    "id":  "manual",
                    "kind":  "human",
                    "label":  "Resolve after retry budget",
                    "task":  "takeover",
                    "runs":  "customer"
                },
                {
                    "t":  "step",
                    "id":  "s6-approve",
                    "kind":  "human",
                    "label":  "Approve exact content and action",
                    "task":  "approve",
                    "runs":  "customer",
                    "subject":  "s4"
                },
                {
                    "t":  "step",
                    "id":  "retry-check",
                    "kind":  "ai",
                    "label":  "Author pushes fixes based on",
                    "task":  "check",
                    "ai":  "qwen3.7-plus",
                    "product":  "model-studio",
                    "runs":  "fc",
                    "why":  "Author pushes fixes based on comments; agent re-reviews only the delta"
                },
                {
                    "t":  "step",
                    "id":  "s2-retrieve",
                    "kind":  "knowledge",
                    "label":  "Retrieve permission-filtered evidence",
                    "task":  "retrieve",
                    "product":  "tablestore",
                    "ai":  "text-embedding-v4",
                    "runs":  "fc",
                    "private":  true
                },
                {
                    "t":  "step",
                    "id":  "s2",
                    "kind":  "knowledge",
                    "label":  "Retrieve repo context, standards,",
                    "runs":  "fc",
                    "private":  true,
                    "product":  "tablestore",
                    "task":  "rerank",
                    "ai":  "qwen3-rerank",
                    "why":  "Retrieve repo context, standards, ownership"
                },
                {
                    "t":  "step",
                    "id":  "s0",
                    "kind":  "trigger",
                    "label":  "PR opened or updated via webhook",
                    "runs":  "fc",
                    "product":  "eventbridge",
                    "untrusted":  true,
                    "private":  true
                },
                {
                    "t":  "step",
                    "id":  "s1",
                    "kind":  "ai",
                    "label":  "Summarize diff and map to ticket",
                    "runs":  "fc",
                    "product":  "model-studio",
                    "task":  "extract",
                    "ai":  "qwen3.8-flash"
                },
                {
                    "t":  "step",
                    "id":  "s5",
                    "kind":  "tool",
                    "runs":  "fc",
                    "why":  "Run tests/build in sandbox to verify claims",
                    "effect":  "read",
                    "label":  "Sandbox tests and build",
                    "product":  "agent-sandbox"
                },
                {
                    "t":  "step",
                    "id":  "s6",
                    "kind":  "act",
                    "label":  "Post inline comments and patches",
                    "runs":  "fc",
                    "effect":  "publish"
                },
                {
                    "t":  "step",
                    "id":  "s3",
                    "kind":  "ai",
                    "runs":  "fc",
                    "product":  "model-studio",
                    "task":  "plan",
                    "ai":  "qwen3.8-max",
                    "why":  "Parallel specialist passes (security, bugs, style)",
                    "label":  "Security review"
                },
                {
                    "t":  "step",
                    "id":  "s4",
                    "kind":  "ai",
                    "label":  "Rank and filter low-value comments",
                    "runs":  "fc",
                    "product":  "model-studio",
                    "task":  "classify",
                    "ai":  "qwen3.8-flash",
                    "join":  "all"
                },
                {
                    "t":  "step",
                    "id":  "style",
                    "kind":  "ai",
                    "label":  "Style review",
                    "ai":  "qwen3.8-max",
                    "task":  "plan",
                    "runs":  "fc",
                    "product":  "model-studio"
                },
                {
                    "t":  "step",
                    "id":  "bugs",
                    "kind":  "ai",
                    "label":  "Bug review",
                    "ai":  "qwen3.8-max",
                    "task":  "plan",
                    "runs":  "fc",
                    "product":  "model-studio"
                },
                {
                    "t":  "link",
                    "id":  "l15",
                    "from":  "s7",
                    "to":  "retry-check",
                    "kind":  "branch",
                    "outcome":  "approve"
                },
                {
                    "t":  "link",
                    "id":  "l13",
                    "from":  "s6-approve",
                    "to":  "s4",
                    "kind":  "branch",
                    "label":  "Revise reviewed output",
                    "outcome":  "edit"
                },
                {
                    "t":  "link",
                    "id":  "l20",
                    "from":  "s8",
                    "to":  "done",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l12",
                    "from":  "s6-approve",
                    "to":  "cancel",
                    "kind":  "branch",
                    "outcome":  "reject"
                },
                {
                    "t":  "link",
                    "id":  "l19",
                    "from":  "retry-route",
                    "to":  "s8",
                    "kind":  "branch",
                    "label":  "Pass or in scope"
                },
                {
                    "t":  "link",
                    "id":  "l14",
                    "from":  "s6",
                    "to":  "s7",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l18",
                    "from":  "retry-check",
                    "to":  "retry-route",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l16",
                    "from":  "s7",
                    "to":  "cancel",
                    "kind":  "branch",
                    "outcome":  "reject"
                },
                {
                    "t":  "link",
                    "id":  "l17",
                    "from":  "s7",
                    "to":  "s4",
                    "kind":  "branch",
                    "label":  "Revise reviewed output",
                    "outcome":  "edit"
                },
                {
                    "t":  "link",
                    "id":  "l4",
                    "from":  "s0",
                    "to":  "s1",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l5",
                    "from":  "s1",
                    "to":  "s2-retrieve",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l3",
                    "from":  "manual",
                    "to":  "cancel",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l2",
                    "from":  "retry-route",
                    "to":  "manual",
                    "kind":  "escalate",
                    "label":  "Retry budget spent",
                    "outcome":  "exhausted"
                },
                {
                    "t":  "link",
                    "id":  "l9",
                    "from":  "s4",
                    "to":  "s5",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l6",
                    "from":  "s2-retrieve",
                    "to":  "s2",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l8",
                    "from":  "s3",
                    "to":  "s4",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l10",
                    "from":  "s5",
                    "to":  "s6-approve",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l1",
                    "from":  "retry-route",
                    "to":  "s1",
                    "kind":  "loop",
                    "label":  "Needs another attempt",
                    "max":  3
                },
                {
                    "t":  "link",
                    "id":  "l7",
                    "from":  "s2",
                    "to":  "s3",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "extra-21",
                    "from":  "s2",
                    "to":  "bugs",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l11",
                    "from":  "s6-approve",
                    "to":  "s6",
                    "kind":  "branch",
                    "outcome":  "approve"
                },
                {
                    "t":  "link",
                    "id":  "extra-23",
                    "from":  "bugs",
                    "to":  "s4",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "extra-24",
                    "from":  "style",
                    "to":  "s4",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "extra-22",
                    "from":  "s2",
                    "to":  "style",
                    "kind":  "next"
                }
            ],
    "expect":  {
                   "codes":  [

                             ]
               }
}
