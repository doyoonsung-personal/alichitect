                    "label":  "Flight status irregularity event",
                    "runs":  "fc",
                    "product":  "eventbridge",
                    "untrusted":  true,
                    "private":  true
                },
                {
                    "t":  "step",
                    "id":  "s5",
                    "kind":  "ai",
                    "label":  "Draft rebooking proposal",
                    "runs":  "fc",
                    "product":  "model-studio",
                    "task":  "generate",
                    "ai":  "qwen3.7-plus"
                },
                {
                    "t":  "step",
                    "id":  "s4",
                    "kind":  "ai",
                    "runs":  "fc",
                    "product":  "model-studio",
                    "task":  "plan",
                    "ai":  "qwen3.8-max",
                    "label":  "Check fare rules and differences"
                },
                {
                    "t":  "step",
                    "id":  "s3",
                    "kind":  "agent",
                    "label":  "Search alternative flights and fares",
                    "runs":  "agentrun",
                    "product":  "model-studio",
