                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l18",
                    "from":  "approve",
                    "to":  "apply",
                    "kind":  "branch",
                    "outcome":  "approve"
                },
                {
                    "t":  "link",
                    "id":  "l19",
                    "from":  "approve",
                    "to":  "save",
                    "kind":  "branch",
                    "outcome":  "reject"
                },
                {
                    "t":  "link",
                    "id":  "l20",
                    "from":  "approve",
