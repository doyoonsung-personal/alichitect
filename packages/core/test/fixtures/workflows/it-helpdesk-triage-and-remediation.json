{
    "id": "it-helpdesk-triage-and-remediation",
    "title": "Internal IT Helpdesk Triage and Remediation",
    "ask": "Create an IT support agent that classifies incoming tickets, checks the knowledge base, runs safe remediations in a sandbox, and asks a manager before touching production",
    "oneRun": "One email via webhook event for this request; bounded retries stay in this run. Later conversation turns, daily checks and monitoring events start new runs using persisted state.",
    "settings": {
        "region": "ap-southeast-1"
    },
    "ops": [
        {
            "t": "step",
            "id": "done",
            "kind": "end",
            "label": "Run complete"
        },
        {
            "t": "step",
            "id": "s7",
            "kind": "human",
            "label": "Approve privileged actions",
            "runs": "customer",
            "product": "agentcore",
            "task": "approve",
            "subject": "s6"
        },
        {
            "t": "step",
            "id": "s9",
            "kind": "act",
            "label": "Log token usage and resolution",
            "runs": "fc",
            "effect": "write"
        },
        {
            "t": "step",
            "id": "s8",
            "kind": "act",
            "label": "Route to queue or notify user",
            "runs": "fc",
            "product": "direct-mail",
            "effect": "send"
        },
        {
            "t": "step",
            "id": "retry-route",
            "kind": "decide",
            "label": "Retry or continue",
            "runs": "fc"
        },
        {
            "t": "step",
            "id": "manual",
            "kind": "human",
            "label": "Resolve after retry budget",
            "task": "takeover",
            "runs": "customer"
        },
        {
            "t": "step",
            "id": "cancel",
            "kind": "end",
            "label": "Cancelled or unresolved"
        },
        {
            "t": "step",
            "id": "retry-check",
            "kind": "ai",
            "label": "User says still broken; re-open with",
            "task": "check",
            "ai": "qwen3.7-plus",
            "product": "model-studio",
            "runs": "fc",
            "why": "User says still broken; re-open with new evidence"
        },
        {
            "t": "step",
            "id": "s2",
            "kind": "ai",
            "label": "Classify category, urgency, dedupe",
            "runs": "fc",
            "product": "model-studio",
            "task": "classify",
            "ai": "qwen3.8-flash"
        },
        {
            "t": "step",
            "id": "s6",
            "kind": "agent",
            "runs": "agentrun",
            "product": "model-studio",
            "turns": 10,
            "task": "plan",
            "ai": "qwen3.8-max",
            "label": "Plan sandbox remediation"
        },
        {
            "t": "step",
            "id": "s3",
            "kind": "ai",
            "label": "Extract device/error context and OCR",
            "runs": "fc",
            "product": "model-studio",
            "task": "extract",
            "ai": "qwen-vl-ocr",
            "why": "Extract device/error context and OCR screenshots"
        },
        {
            "t": "step",
            "id": "s0",
            "kind": "trigger",
            "label": "Inbound email via webhook to EventBridge",
            "runs": "fc",
            "product": "eventbridge",
            "untrusted": true,
            "private": true
        },
        {
            "t": "step",
            "id": "s1",
            "kind": "ai",
            "label": "Transcribe voice if call/walk-up",
            "runs": "fc",
            "product": "model-studio",
            "task": "transcribe",
            "ai": "qwen-audio-3.1-asr-flash"
        },
        {
            "t": "step",
            "id": "s5",
            "kind": "ai",
            "label": "Check for known live incident",
            "runs": "fc",
            "product": "model-studio",
            "task": "classify",
            "ai": "qwen3.8-flash"
        },
        {
            "t": "step",
            "id": "s5-route",
            "kind": "decide",
            "label": "Route by evaluated result",
            "runs": "fc"
        },
        {
            "t": "step",
            "id": "s4-retrieve",
            "kind": "knowledge",
            "label": "Retrieve permission-filtered evidence",
            "task": "retrieve",
            "product": "tablestore",
            "ai": "text-embedding-v4",
            "runs": "fc",
            "private": true
        },
        {
            "t": "step",
            "id": "s4",
            "kind": "knowledge",
            "label": "Retrieve KB articles and past tickets",
            "runs": "fc",
            "private": true,
            "product": "tablestore",
            "task": "rerank",
            "ai": "qwen3-rerank"
        },
        {
            "t": "step",
            "id": "input-type",
            "kind": "decide",
            "label": "Email text or voice attachment",
            "runs": "fc"
        },
        {
            "t": "step",
            "id": "apply",
            "kind": "act",
            "label": "Apply approved privileged change",
            "effect": "admin",
            "runs": "customer"
        },
        {
            "t": "step",
            "id": "sandbox",
            "kind": "tool",
            "label": "Test remediation safely",
            "effect": "write",
            "runs": "fc",
            "on": "s6",
            "product": "agent-sandbox"
        },
        {
            "t": "link",
            "id": "l11",
            "from": "s5-route",
            "to": "s6",
            "kind": "branch",
            "label": "Pass or in scope"
        },
        {
            "t": "link",
            "id": "l18",
            "from": "retry-check",
            "to": "retry-route",
            "kind": "next"
        },
        {
            "t": "link",
            "id": "l13",
            "from": "s6",
            "to": "s7",
            "kind": "next"
        },
        {
            "t": "link",
            "id": "l20",
            "from": "s9",
            "to": "done",
            "kind": "next"
        },
        {
            "t": "link",
            "id": "l15",
            "from": "s7",
            "to": "cancel",
            "kind": "branch",
            "outcome": "reject"
        },
        {
            "t": "link",
            "id": "l3",
            "from": "manual",
            "to": "cancel",
            "kind": "next"
        },
        {
            "t": "link",
            "id": "l17",
            "from": "s8",
            "to": "retry-check",
            "kind": "next"
        },
        {
            "t": "link",
            "id": "l5",
            "from": "s1",
            "to": "s2",
            "kind": "next"
        },
        {
            "t": "link",
            "id": "l16",
            "from": "s7",
            "to": "s6",
            "kind": "branch",
            "label": "Revise reviewed output",
            "outcome": "edit"
        },
        {
            "t": "link",
            "id": "l1",
            "from": "retry-route",
            "to": "s1",
            "kind": "loop",
            "label": "Needs another attempt",
            "max": 3
        },
        {
            "t": "link",
            "id": "l2",
            "from": "retry-route",
            "to": "manual",
            "kind": "escalate",
            "label": "Retry budget spent",
            "outcome": "exhausted"
        },
        {
            "t": "link",
            "id": "l19",
            "from": "retry-route",
            "to": "s9",
            "kind": "branch",
            "label": "Pass or in scope"
        },
        {
            "t": "link",
            "id": "l8",
            "from": "s4-retrieve",
            "to": "s4",
            "kind": "next"
        },
        {
            "t": "link",
            "id": "l6",
            "from": "s2",
            "to": "s3",
            "kind": "next"
        },
        {
            "t": "link",
            "id": "l10",
            "from": "s5",
            "to": "s5-route",
            "kind": "next"
        },
        {
            "t": "link",
            "id": "l7",
            "from": "s3",
            "to": "s4-retrieve",
            "kind": "next"
        },
        {
            "t": "link",
            "id": "l9",
            "from": "s4",
            "to": "s5",
            "kind": "next"
        },
        {
            "t": "link",
            "id": "extra-22",
            "from": "input-type",
            "to": "s1",
            "kind": "branch",
            "label": "Audio"
        },
        {
            "t": "link",
            "id": "extra-21",
            "from": "apply",
            "to": "s8",
            "kind": "next"
        },
        {
            "t": "link",
            "id": "l12",
            "from": "s5-route",
            "to": "cancel",
            "kind": "branch",
            "label": "No result or out of scope"
        },
        {
            "t": "link",
            "id": "extra-20",
            "from": "s7",
            "to": "apply",
            "kind": "branch",
            "outcome": "approve"
        },
        {
            "t": "link",
            "id": "extra-23",
            "from": "input-type",
            "to": "s2",
            "kind": "branch",
            "label": "Text"
        },
        {
            "t": "link",
            "id": "extra-21-b",
            "from": "s0",
            "to": "input-type",
            "kind": "next"
        }
    ],
    "expect": {
        "codes": []
    }
}
