{
    "id":  "employee-onboarding-helpdesk",
    "title":  "Employee Onboarding Q\u0026A and HR Helpdesk",
    "ask":  "Build an HR bot that answers new-hire policy questions from chat, retrieves the right handbook section, and escalates to a human if it isn\u0027t sure",
    "oneRun":  "One new-hire question or request; administrative fulfilment needs explicit authorization.",
    "settings":  {
                     "region":  "ap-southeast-1"
                 },
    "ops":  [
                {
                    "t":  "step",
                    "id":  "in",
                    "kind":  "trigger",
                    "label":  "New-hire message",
                    "product":  "eventbridge",
                    "runs":  "fc",
                    "untrusted":  true,
                    "private":  true
                },
                {
                    "t":  "step",
                    "id":  "intent",
                    "kind":  "ai",
                    "label":  "Classify request",
                    "task":  "classify",
                    "product":  "model-studio",
                    "ai":  "qwen3.8-flash",
                    "runs":  "fc"
                },
                {
                    "t":  "step",
                    "id":  "entities",
                    "kind":  "ai",
                    "label":  "Extract request details",
                    "task":  "extract",
                    "product":  "model-studio",
                    "ai":  "qwen3.8-flash",
                    "runs":  "fc"
                },
                {
                    "t":  "step",
                    "id":  "kb",
