// alichitect: one Worker serving the architecture builder at https://architect.alikorea-demo.com.
// It gates every request (email-and-password accounts, admin approval), serves the SPA from apps/web/dist and runs POST /api/turn
// against Model Studio (dashscope-intl). Account: Dysung.alicloud@gmail.com's Account (Workers Paid), which also owns
// alikorea-demo.com for other demos, so the only route is the custom domain below. Deploy steps: docs/DEPLOY.md.
//
// Secrets (never in this file; set with scripts/set-secrets.ps1): DASHSCOPE_API_KEY, SESSION_SECRET, and optionally
// ANTHROPIC_API_KEY (the Claude backup that finishes turns Model Studio's content filter stops; without it, no backup).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alichitect",
  "account_id": "cfd2a327acfb7d93dc045825f12dd38d",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  // request.signal aborts when the browser disconnects, so the upstream Qwen request is cancelled with it
  "compatibility_flags": ["enable_request_signal"],
  "assets": {
    "directory": "../web/dist", // built by `npm run build` in apps/web before every deploy (scripts/deploy.ps1)
    "binding": "ASSETS",
    "run_worker_first": true, // every request goes through the sign-in gate first
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "d1_databases": [
    // production database, created 2026-11-01 with `wrangler d1 create alichitect` (APAC)
    { "binding": "DB", "database_name": "alichitect", "database_id": "02e2a628-25c3-492f-b71f-89bb92b452b9", "migrations_dir": "migrations" }
  ],
  // Cloudflare Email Service, as in the WonderClip platform: the sender domain alikorea-demo.com is already onboarded.
  // It sends the sign-up and reset codes, so sign-up cannot work without it.
  "send_email": [{ "name": "EMAIL", "remote": true }],
  "vars": {
    "ADMIN_EMAILS": "dysung.alicloud@gmail.com", // comma-separated; approved admins as soon as they confirm their email
    "TURNS_PER_DAY": "60", // per non-admin user, UTC day; admins are unlimited
    "ALLOWED_ORIGIN": "https://architect.alikorea-demo.com",
    "MAIL_FROM": "no-reply@alikorea-demo.com",
    "SITE_NAME": "Alibaba Cloud Architecture Builder",
    "NOTIFY_ON_APPROVAL": "1",
    "REQUEST_MAILS_PER_DAY": "30", // access-request mails to the admins per rolling day; later requests are kept but not mailed
    "CLAUDE_BACKUP_MODEL": "claude-opus-5-5", // the Claude backup's model; used only when the ANTHROPIC_API_KEY secret is set
    // Caps on the Claude backup (it spends the owner's Anthropic credit, and anyone can write text that trips the content filter).
    // A rescue starts only while the user is under their daily count and the day's Claude cost, all users together, is under the
    // budget (migration 0003, src/turn.ts). A rescued turn also counts as 2 of TURNS_PER_DAY. Past a cap a filtered turn ends
    // with the "backup limit reached" message, as if there were no backup.
    "CLAUDE_RESCUES_PER_USER_DAY": "10",
    "CLAUDE_RESCUES_PER_ADMIN_DAY": "30",
    "CLAUDE_BUDGET_USD_PER_DAY": "5",
    // Abuse caps on code mails per rolling day, all addresses together. Three separate pools, so a flood of one kind cannot
    // starve another: sign-ups, password resets, and a reserve for the ADMIN_EMAILS addresses. A spent pool is shown on the
    // page ("temporarily unavailable") and logged as mail-cap-reached.
    "CODE_MAILS_PER_DAY": "100",
    "RESET_MAILS_PER_DAY": "50",
    "ADMIN_CODE_MAILS_PER_DAY": "40"
  },
  "routes": [{ "pattern": "architect.alikorea-demo.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Application logs only (our own metadata lines: user ids, outcomes, never an address, password or code). Invocation
  // logs stay off, so request URLs and client details are not stored in Cloudflare's logs.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "limits": { "cpu_ms": 60000 },

  // Local development and the end-to-end check: `npm run dev` (wrangler dev --env dev --port 8800).
  // No email is sent: MAIL_LOG writes each mail's recipient and subject (which carries the code) to the wrangler dev
  // output instead. The Worker ignores MAIL_LOG unless ALLOWED_ORIGIN is plain http on a loopback address
  // (mailLogAllowed in src/env.ts), so it can never put codes in production logs. D1 is the local simulator.
  "env": {
    "dev": {
      "d1_databases": [
        { "binding": "DB", "database_name": "alichitect", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
      ],
      // simulated locally (no "remote"), and MAIL_LOG below means nothing is handed to it anyway
      "send_email": [{ "name": "EMAIL" }],
      "vars": {
        "ADMIN_EMAILS": "dysung.alicloud@gmail.com",
        "TURNS_PER_DAY": "60",
        "ALLOWED_ORIGIN": "http://localhost:8800",
        "MAIL_FROM": "no-reply@alikorea-demo.com",
        "SITE_NAME": "Alibaba Cloud Architecture Builder",
        "NOTIFY_ON_APPROVAL": "1",
        "REQUEST_MAILS_PER_DAY": "30",
        "CLAUDE_BACKUP_MODEL": "claude-opus-5-5",
        "CLAUDE_RESCUES_PER_USER_DAY": "10",
        "CLAUDE_RESCUES_PER_ADMIN_DAY": "30",
        "CLAUDE_BUDGET_USD_PER_DAY": "5",
        "CODE_MAILS_PER_DAY": "100",
        "RESET_MAILS_PER_DAY": "50",
        "ADMIN_CODE_MAILS_PER_DAY": "40",
        "MAIL_LOG": "1"
      },
      // Secrets come from .dev.vars (dummy values); with --env-file they may come from the process environment instead.
      // ANTHROPIC_API_KEY is optional and not listed: without it the dev Worker runs without the Claude backup.
      "secrets": { "required": ["DASHSCOPE_API_KEY", "SESSION_SECRET"] },
      "routes": [],
      "workers_dev": false
    }
  }
}
