{
    "id":  "ecommerce-shopping-assistant",
    "title":  "E-commerce Shopping Assistant",
    "ask":  "Build a shopping assistant that recommends products from our catalog and applies coupons with checkout approval",
    "oneRun":  "One chat message event for this request; bounded retries stay in this run. Later conversation turns, daily checks and monitoring events start new runs using persisted state.",
    "settings":  {
                     "region":  "ap-southeast-1"
                 },
    "ops":  [
                {
                    "t":  "step",
                    "id":  "s9",
                    "kind":  "act",
                    "label":  "Log interaction",
                    "runs":  "fc",
                    "product":  "tablestore",
                    "effect":  "write"
                },
                {
                    "t":  "step",
                    "id":  "done",
                    "kind":  "end",
                    "label":  "Run complete"
                },
                {
                    "t":  "step",
                    "id":  "s7",
                    "kind":  "human",
                    "label":  "Approve payment or coupon application",
                    "runs":  "customer",
                    "task":  "approve",
                    "subject":  "s4"
                },
                {
                    "t":  "step",
                    "id":  "s8",
                    "kind":  "act",
                    "label":  "Add to cart or start checkout",
                    "runs":  "fc",
                    "effect":  "pay"
                },
                {
                    "t":  "step",
                    "id":  "retry-route",
                    "kind":  "decide",
                    "label":  "Retry or continue",
                    "runs":  "fc"
                },
                {
                    "t":  "step",
                    "id":  "manual",
                    "kind":  "human",
                    "label":  "Resolve after retry budget",
                    "task":  "takeover",
                    "runs":  "customer"
                },
                {
                    "t":  "step",
                    "id":  "cancel",
                    "kind":  "end",
                    "label":  "Cancelled or unresolved"
                },
                {
                    "t":  "step",
                    "id":  "retry-check",
                    "kind":  "ai",
                    "label":  "Regeneration loop when guardrail",
                    "task":  "check",
                    "ai":  "qwen3.7-plus",
                    "product":  "model-studio",
                    "runs":  "fc",
                    "why":  "Regeneration loop when guardrail detects fabricated stock/price claims"
                },
                {
                    "t":  "step",
                    "id":  "s2-retrieve",
                    "kind":  "knowledge",
                    "label":  "Retrieve permission-filtered evidence",
                    "task":  "retrieve",
                    "product":  "opensearch",
                    "ai":  "text-embedding-v4",
                    "runs":  "fc",
                    "private":  true
                },
                {
                    "t":  "step",
                    "id":  "s2",
                    "kind":  "knowledge",
                    "label":  "Semantic product search",
                    "runs":  "fc",
                    "product":  "opensearch",
                    "private":  true,
                    "task":  "rerank",
                    "ai":  "qwen3-rerank"
                },
                {
                    "t":  "step",
                    "id":  "s0",
                    "kind":  "trigger",
                    "label":  "User query or page event",
                    "runs":  "fc",
                    "product":  "eventbridge",
                    "untrusted":  true,
                    "private":  true
                },
                {
                    "t":  "step",
                    "id":  "s1",
                    "kind":  "ai",
                    "label":  "Understand query constraints",
                    "runs":  "fc",
                    "product":  "model-studio",
                    "task":  "extract",
                    "ai":  "qwen3.8-flash"
                },
                {
                    "t":  "step",
                    "id":  "s5",
                    "kind":  "tool",
                    "label":  "Deterministic price and stock check",
                    "runs":  "fc",
                    "product":  "fc",
                    "effect":  "read"
                },
                {
                    "t":  "step",
                    "id":  "s6",
                    "kind":  "guard",
                    "label":  "Guardrail scan for fabricated claims",
                    "runs":  "fc",
                    "product":  "ai-guardrails"
                },
                {
                    "t":  "step",
                    "id":  "s3",
                    "kind":  "tool",
                    "effect":  "read",
                    "runs":  "customer",
                    "label":  "Customer personalization recall"
                },
                {
                    "t":  "step",
                    "id":  "s4",
                    "kind":  "ai",
                    "label":  "Generate recommendation",
                    "runs":  "fc",
                    "product":  "model-studio",
                    "task":  "generate",
                    "ai":  "qwen3.7-plus"
                },
                {
                    "t":  "link",
                    "id":  "l12",
                    "from":  "retry-check",
                    "to":  "retry-route",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l13",
                    "from":  "retry-route",
                    "to":  "s7",
                    "kind":  "branch",
                    "label":  "Pass or in scope"
                },
                {
                    "t":  "link",
                    "id":  "l10",
                    "from":  "s5",
                    "to":  "s6",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l11",
                    "from":  "s6",
                    "to":  "retry-check",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l14",
                    "from":  "s7",
                    "to":  "s8",
                    "kind":  "branch",
                    "outcome":  "approve"
                },
                {
                    "t":  "link",
                    "id":  "l17",
                    "from":  "s8",
                    "to":  "s9",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l18",
                    "from":  "s9",
                    "to":  "done",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l15",
                    "from":  "s7",
                    "to":  "cancel",
                    "kind":  "branch",
                    "outcome":  "reject"
                },
                {
                    "t":  "link",
                    "id":  "l16",
                    "from":  "s7",
                    "to":  "s4",
                    "kind":  "branch",
                    "label":  "Revise reviewed output",
                    "outcome":  "edit"
                },
                {
                    "t":  "link",
                    "id":  "l3",
                    "from":  "manual",
                    "to":  "cancel",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l4",
                    "from":  "s0",
                    "to":  "s1",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l1",
                    "from":  "retry-route",
                    "to":  "s4",
                    "kind":  "loop",
                    "label":  "Needs another attempt",
                    "max":  2
                },
                {
                    "t":  "link",
                    "id":  "l2",
                    "from":  "retry-route",
                    "to":  "manual",
                    "kind":  "escalate",
                    "label":  "Retry budget spent",
                    "outcome":  "exhausted"
                },
                {
                    "t":  "link",
                    "id":  "l5",
                    "from":  "s1",
                    "to":  "s2-retrieve",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l8",
                    "from":  "s3",
                    "to":  "s4",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l9",
                    "from":  "s4",
                    "to":  "s5",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l6",
                    "from":  "s2-retrieve",
                    "to":  "s2",
                    "kind":  "next"
                },
                {
                    "t":  "link",
                    "id":  "l7",
                    "from":  "s2",
                    "to":  "s3",
                    "kind":  "next"
                }
            ],
    "expect":  {
                   "codes":  [

                             ]
               }
}
