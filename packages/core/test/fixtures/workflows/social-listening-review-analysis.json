                    "product":  "chatapp",
                    "effect":  "publish",
                    "why":  "Post approved reply or route defect ticket to product",
                    "label":  "Post approved public reply"
                },
                {
                    "t":  "step",
                    "id":  "done",
                    "kind":  "end",
                    "label":  "Run complete"
                },
                {
                    "t":  "step",
                    "id":  "s8",
                    "kind":  "ai",
                    "label":  "Draft public reply in reviewer",
