                    "runs":  "fc",
                    "private":  true
                },
                {
                    "t":  "step",
                    "id":  "rank",
                    "kind":  "knowledge",
                    "label":  "Rank policies",
                    "task":  "rerank",
                    "product":  "model-studio",
                    "ai":  "qwen3-rerank",
                    "runs":  "fc"
                },
                {
                    "t":  "step",
                    "id":  "draft",
                    "kind":  "ai",
                    "label":  "Cited answer and request plan",
                    "task":  "generate",
                    "product":  "model-studio",
                    "ai":  "qwen3.7-plus",
                    "runs":  "fc"
                },
                {
                    "t":  "step",
                    "id":  "check",
                    "kind":  "ai",
                    "label":  "Check confidence and scope",
                    "task":  "check",
                    "product":  "model-studio",
                    "ai":  "qwen3.7-plus",
                    "runs":  "fc"
                },
                {
                    "t":  "step",
                    "id":  "guard",
                    "kind":  "guard",
                    "label":  "Screen answer",
                    "product":  "ai-guardrails",
                    "runs":  "fc"
                },
                {
                    "t":  "step",
                    "id":  "route",
                    "kind":  "decide",
                    "label":  "Answer action or takeover",
                    "runs":  "fc"
                },
                {
                    "t":  "step",
                    "id":  "approve",
                    "kind":  "human",
                    "label":  "Approve fulfilment",
                    "task":  "approve",
                    "runs":  "customer",
                    "subject":  "draft"
                },
                {
                    "t":  "step",
                    "id":  "act",
                    "kind":  "act",
                    "label":  "Order device or add group",
                    "effect":  "admin",
                    "runs":  "customer"
                },
                {
                    "t":  "step",
                    "id":  "reply",
                    "kind":  "act",
                    "label":  "Answer employee",
                    "effect":  "reply",
                    "runs":  "customer"
                },
                {
                    "t":  "step",
                    "id":  "human",
                    "kind":  "human",
                    "label":  "HR generalist takeover",
                    "task":  "takeover",
                    "runs":  "customer"
                },
                {
                    "t":  "step",
                    "id":  "save",
                    "kind":  "act",
                    "label":  "Capture feedback",
                    "product":  "tablestore",
                    "effect":  "write",
                    "runs":  "fc"
                },
                {
                    "t":  "step",
                    "id":  "end",
                    "kind":  "end",
                    "label":  "Done"
                },
                {
