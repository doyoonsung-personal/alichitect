{
    "id":  "social-listening-review-analysis",
    "title":  "Social listening and review analysis",
    "ask":  "Build an agent that ingests marketplace reviews, clusters them by theme, drafts replies for negative ones, and holds them for PR approval before posting.",
    "oneRun":  "One schedule event for this request; bounded retries stay in this run. Later conversation turns, daily checks and monitoring events start new runs using persisted state.",
    "settings":  {
                     "region":  "ap-southeast-1"
                 },
