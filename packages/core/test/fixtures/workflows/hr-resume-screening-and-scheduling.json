                },
                {
                    "t":  "step",
                    "id":  "done",
                    "kind":  "end",
                    "label":  "Run complete"
                },
                {
                    "t":  "step",
                    "id":  "s8",
                    "kind":  "act",
                    "runs":  "fc",
                    "product":  "direct-mail",
                    "effect":  "send",
                    "label":  "Send approved interview invitation"
                },
                {
                    "t":  "step",
                    "id":  "s9",
